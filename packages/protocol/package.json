{
  "name": "@chkobba/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Chkobba online wire protocol shared by server and client: types, consts and pure dependency-free helpers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chkobba/rules": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
