# Nakama connection for online play. Copy to `.env.local` and adjust.
# Expo inlines EXPO_PUBLIC_* variables into the app bundle at build time:
# never put secrets here. The Nakama *server key* is a public client key,
# not a secret (the console password and http_key stay server-side).
#
# Unset or malformed values fall back to the local docker compose defaults
# shown below.

# Host of the Nakama API. For a phone on the LAN (Expo Go), use your
# computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_NAKAMA_HOST=127.0.0.1

# Nakama API port (HTTP + realtime socket).
EXPO_PUBLIC_NAKAMA_PORT=7350

# Server key (socket.server_key in the Nakama config). `defaultkey` is the
# local default; production servers must use their own.
EXPO_PUBLIC_NAKAMA_KEY=defaultkey

# true for https/wss. Must be true for any non-local server: session tokens
# and the guest device id travel in these requests.
EXPO_PUBLIC_NAKAMA_SSL=false

# Optional: web origin used in private-table share links (`<origin>/t/<CODE>`).
# Must be an http or https origin with no path, query or hash (a single
# trailing / is ignored). Plain http is fine for LAN testing, e.g. your
# computer's LAN IP and the Expo web port. Unset or malformed: players share
# the code only, with no link.
# EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.20:8081
